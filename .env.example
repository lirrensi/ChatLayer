# Botoraptor Environment Variables
# Copy this file to .env and update with your values

# The v4 launcher owns the database location. This value is ignored and replaced
# with data/db/botoraptor.db so direct and Docker modes cannot diverge.
DATABASE_URL="file:./data/db/botoraptor.db"

# Secret key for signing file upload URLs
# Generate a strong random string for production
# npm start creates a cryptographically random value when this is absent.
FILE_SIGNING_SECRET=generate-a-strong-random-secret
